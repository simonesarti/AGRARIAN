# =============================================================================
# db_writer sidecar — database connection configuration
# =============================================================================
# When running via docker-compose these values are injected by the compose file
# from the root .env (DB_* variables). This file is used only when running
# the sidecar standalone outside compose.
# =============================================================================

DB_SERVICE=postgresql
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_WORKER_NAME=
DB_WORKER_PASSWORD=
