# -----------------------------------------------------------------------------
# DATABASE  (partner-hosted — credentials provided by the partner)
# DB_SERVICE: database engine (postgresql, mysql, ...)
# -----------------------------------------------------------------------------
DB_SERVICE=postgresql
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_WORKER_NAME=
DB_WORKER_PASSWORD=

# -----------------------------------------------------------------------------
# MEDIAMTX
# Required for WebRTC: tells MediaMTX to advertise this IP in ICE candidates
# so the browser can reach it through Docker's network NAT.
# Set to the comms machine's IP or hostname.
# -----------------------------------------------------------------------------
MEDIAMTX_HOST=

# -----------------------------------------------------------------------------
# WEBSOCKET SERVER
#
# SESSION_JWT_SECRET: signs the viewer tokens that scope a WebSocket connection
#   to a single flight. db-writer mints, ws-server validates — both services must
#   carry the same value. Generate with: openssl rand -hex 32
# PUBLISHER_TOKEN_TTL_S: lifetime of the per-flight token an app container uses to
#   write alerts. Minted by db-writer when the flight opens and accepted by both
#   db-writer and ws-server; there is no pre-shared publisher secret.
# VIEWER_TOKEN_TTL_S: lifetime of a viewer token. Tokens travel in the WebSocket
#   query string (browsers cannot set headers on a handshake) and therefore reach
#   proxy access logs, so this bounds how long a leaked one stays useful.
# -----------------------------------------------------------------------------
WS_PORT=8765
SESSION_JWT_SECRET=
PUBLISHER_TOKEN_TTL_S=86400
VIEWER_TOKEN_TTL_S=43200

# -----------------------------------------------------------------------------
# PORTAL  (the account pages — the only service on the public side)
#
# The portal holds NO database credentials and NOT the JWT secret. It forwards the
# session cookie to db-writer and lets db-writer decide, which is what keeps the
# key that signs every credential out of the internet-facing tier.
#
# WS_PUBLIC_HOST: hostname the BROWSER uses to reach ws-server for alerts. Empty
#   falls back to MEDIAMTX_HOST, which is right when one host fronts both.
# PORTAL_COOKIE_SECURE / PORTAL_PUBLIC_TLS: leave true. Set false ONLY to run the
#   portal over plain http:// locally — a Secure cookie is not sent over http, and
#   the symptom is a login that appears to succeed and then forgets you.
# PORTAL_ALLOWED_ORIGIN_HOSTS: comma-separated extra hostnames accepted on the
#   cross-site check. Needed only where a proxy rewrites Host so it no longer
#   matches the Origin the browser sends.
# PORTAL_TRUSTED_PROXY_HOPS: how many proxies stand between the browser and the
#   portal. It decides which X-Forwarded-For entry the rate limiter believes, so
#   it must match the real deployment: 0 when the portal is reached directly, 1
#   behind Traefik alone. Setting it HIGHER than the truth is the dangerous
#   direction — the client then names its own bucket, and can push another
#   client's to the limit.
# -----------------------------------------------------------------------------
WS_PUBLIC_HOST=
PORTAL_COOKIE_SECURE=true
PORTAL_PUBLIC_TLS=true
PORTAL_ALLOWED_ORIGIN_HOSTS=
PORTAL_TRUSTED_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# ORCHESTRATOR  (one GPU container per active flight)
#
# APP_IMAGE: the GPU app image the orchestrator runs for each flight. Required —
#   there is no sensible default, and guessing one would silently run the wrong
#   pipeline.
# APP_GPUS: passed to Docker as the device request. 'all', or a comma-separated
#   list of device ids to pin flights to particular cards.
# APP_SHM_SIZE: Docker's 64 MB default causes a silent SIGBUS in the annotation
#   worker once frame buffers live in shared memory.
# RECONNECT_GRACE_S: how long a flight's container survives after the publisher
#   drops. MediaMTX reports a momentary radio glitch the same way it reports a
#   landing, and a cold GPU start reloads model weights. 0 tears down immediately.
# -----------------------------------------------------------------------------
APP_IMAGE=
APP_GPUS=all
APP_SHM_SIZE=256m
RECONNECT_GRACE_S=30

# -----------------------------------------------------------------------------
# RECORDING  (MediaMTX records the annotated stream; recorder sidecar uploads it)
# RECORDING_STORE_SERVICE: local | azure | aws
#   local — file stays on the recordings Docker volume
#   azure — upload to Azure Blob Storage (requires RECORDING_AZURE_* vars)
#   aws   — upload to AWS S3 (requires RECORDING_AWS_* vars)
# RECORDING_DELETE_LOCAL_ON_SUCCESS: delete the local file after a successful
#   remote upload (ignored when service=local)
# -----------------------------------------------------------------------------
RECORDING_STORE_SERVICE=local
RECORDING_DELETE_LOCAL_ON_SUCCESS=false

# Azure Blob Storage
RECORDING_AZURE_CONNECTION_STRING=
RECORDING_AZURE_CONTAINER_NAME=
RECORDING_AZURE_BLOB_PREFIX=

# AWS S3
RECORDING_AWS_BUCKET_NAME=
RECORDING_AWS_KEY_PREFIX=
RECORDING_AWS_ACCESS_KEY_ID=
RECORDING_AWS_SECRET_ACCESS_KEY=
RECORDING_AWS_REGION_NAME=
