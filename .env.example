# -----------------------------------------------------------------------------
# DATABASE  (partner-hosted — credentials provided by the partner)
# DB_SERVICE: database engine (postgresql, mysql, ...)
# -----------------------------------------------------------------------------
DB_SERVICE=postgresql
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_WORKER_NAME=
DB_WORKER_PASSWORD=

# -----------------------------------------------------------------------------
# MEDIAMTX
# Required for WebRTC: tells MediaMTX to advertise this IP in ICE candidates
# so the browser can reach it through Docker's network NAT.
# Set to the comms machine's IP or hostname.
#
# This is also the host the portal composes every URL from — the viewer-facing
# ones and the rtmps:// ingest URL it prints on the slots page — so whatever goes
# here must be covered by the certificate the terminators serve, all three of
# which now verify. The local generator adds the machine's primary IP as a SAN for
# exactly that reason; a name works too, once one exists.
# -----------------------------------------------------------------------------
MEDIAMTX_HOST=

# -----------------------------------------------------------------------------
# TLS  (the ingress tier — see CLOUD_ARCHITECTURE.md §7)
#
# Three terminators, one certificate. Traefik takes HTTPS and WSS for the portal,
# MediaMTX's HLS and WHEP signalling, and ws-server's viewer WebSocket; MediaMTX
# takes RTMPS 1936 and RTSPS 8322; Mosquitto takes MQTTS 8883. The last two
# terminate their own rather than sitting behind Traefik, because that is what
# preserves the client identity their auth hook and ACLs depend on.
#
# There is nothing to configure here, but there IS something to run:
#
#   ./scripts/generate_local_certs.sh [domain]
#
# It writes certificates/server/{server.crt,server.key,ca.crt}, which all three
# services mount, and certificates/ca/ca.crt, which you trust in the browser or
# pass to curl as --cacert.
#
# RUN IT BEFORE `docker compose up`, not after. MediaMTX now EXITS at startup if
# the certificate it is configured to read is missing, so the whole video plane is
# down rather than degraded — and Mosquitto starts without its 8883 listener.
#
# This stands in for cert-manager only until a hostname exists: Let's Encrypt
# will not issue for an IP address, which is the first ask in §9. When a name
# resolves here, the ACME block at the bottom of configs/traefik/traefik.yml
# replaces the script and nothing else in the stack changes.
#
# The plaintext listeners are still published and still work — RTMP 1935, RTSP
# 8554, MQTT 1883 — because §7 keeps them as a narrow fallback for drone firmware
# that cannot do TLS. Nothing forces a drone onto the encrypted port; point every
# one that can at the rtmps:// URL the portal prints, since the stream key it
# carries is both the credential and the path and never expires.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# WEBSOCKET SERVER
#
# WS_PORT: the port a VIEWER dials for the alert WebSocket, which is Traefik's
#   WSS entrypoint on the host. Inside comms-net the hop is fixed at 8765 on both
#   sides, because Traefik's static config cannot interpolate a variable and an
#   inner port that disagreed with the entrypoint would fail silently.
# SESSION_JWT_SECRET: signs the viewer tokens that scope a WebSocket connection
#   to a single flight. db-writer mints, ws-server validates — both services must
#   carry the same value. Generate with: openssl rand -hex 32
# PUBLISHER_TOKEN_TTL_S: lifetime of the per-flight token an app container uses to
#   write alerts. Minted by db-writer when the flight opens and accepted by both
#   db-writer and ws-server; there is no pre-shared publisher secret.
# VIEWER_TOKEN_TTL_S: lifetime of a viewer token. Tokens travel in the WebSocket
#   query string (browsers cannot set headers on a handshake) and therefore reach
#   proxy access logs, so this bounds how long a leaked one stays useful.
# -----------------------------------------------------------------------------
WS_PORT=8765
SESSION_JWT_SECRET=
PUBLISHER_TOKEN_TTL_S=86400
VIEWER_TOKEN_TTL_S=43200

# -----------------------------------------------------------------------------
# PORTAL  (the account pages — the only service on the public side)
#
# The portal holds NO database credentials and NOT the JWT secret. It forwards the
# session cookie to db-writer and lets db-writer decide, which is what keeps the
# key that signs every credential out of the internet-facing tier.
#
# WS_PUBLIC_HOST: hostname the BROWSER uses to reach ws-server for alerts. Empty
#   falls back to MEDIAMTX_HOST, which is right when one host fronts both.
# PORTAL_COOKIE_SECURE / PORTAL_PUBLIC_TLS: leave true. Set false ONLY to run the
#   portal over plain http:// locally — a Secure cookie is not sent over http, and
#   the symptom is a login that appears to succeed and then forgets you.
# PORTAL_ALLOWED_ORIGIN_HOSTS: comma-separated extra hostnames accepted on the
#   cross-site check. Needed only where a proxy rewrites Host so it no longer
#   matches the Origin the browser sends.
# PORTAL_TRUSTED_PROXY_HOPS: how many proxies stand between the browser and the
#   portal. It decides which X-Forwarded-For entry the rate limiter believes, so
#   count the real hops in YOUR deployment rather than copying a number: 1 for
#   the compose stack, where Traefik is the single HTTP proxy in front, and 2 if
#   a cloud L7 load balancer also sits in front of that. An L4 load balancer
#   preserving the source IP adds no hop. Setting it HIGHER than the truth is the
#   dangerous direction — the client then names its own bucket, and can push
#   another client's to the limit. Setting it LOWER is not free either: at 0
#   behind Traefik every client counts into one bucket, so a single attacker
#   locks out everybody.
# -----------------------------------------------------------------------------
WS_PUBLIC_HOST=
PORTAL_COOKIE_SECURE=true
PORTAL_PUBLIC_TLS=true
PORTAL_ALLOWED_ORIGIN_HOSTS=
PORTAL_TRUSTED_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# ORCHESTRATOR  (one GPU container per active flight)
#
# FLIGHT_RUNTIME: docker | kubernetes. Which FlightRuntime backend runs flights.
#   'docker' needs /var/run/docker.sock and is what this compose stack uses;
#   'kubernetes' creates one Job per flight and is the deployment setting. The
#   flight lifecycle is identical either way — see orchestrator/runtime.py.
# APP_IMAGE: the GPU app image the orchestrator runs for each flight. Required —
#   there is no sensible default, and guessing one would silently run the wrong
#   pipeline.
# APP_SHM_SIZE: Docker's 64 MB default causes a silent SIGBUS in the annotation
#   worker once frame buffers live in shared memory. Written in Docker's spelling
#   under both backends; the Kubernetes one translates it (256m -> 256Mi).
# RECONNECT_GRACE_S: how long a flight's container survives after the publisher
#   drops. MediaMTX reports a momentary radio glitch the same way it reports a
#   landing, and a cold GPU start reloads model weights. 0 tears down immediately.
#   This decides flight identity: inside the window it is the same flight, outside
#   it the next takeoff is a new one. Must stay well below the time a battery swap
#   takes, or two flights are recorded as one.
# -----------------------------------------------------------------------------
FLIGHT_RUNTIME=docker
APP_IMAGE=
APP_SHM_SIZE=256m
RECONNECT_GRACE_S=120

# --- FLIGHT_RUNTIME=docker only ---------------------------------------------
# APP_GPUS: passed to Docker as the device request. 'all', or a comma-separated
#   list of device ids to pin flights to particular cards. Has no meaning under
#   Kubernetes, where the scheduler picks the node and the device plugin the card.
APP_GPUS=all

# --- FLIGHT_RUNTIME=kubernetes only -----------------------------------------
# Apply configs/k8s/orchestrator-rbac.yaml first: it creates both namespaces and
# the service account that replaces the Docker socket.
#
# APP_NAMESPACE: where flight Jobs are created. Kept separate from the hub's own
#   namespace so the orchestrator's Role is a grant into a namespace it does not
#   otherwise live in.
# APP_GPU_COUNT: nvidia.com/gpu per flight. 0 or unset requests no GPU, which is
#   what a test cluster without a device plugin can actually schedule.
# APP_NODE_SELECTOR: key=value,key=value pinning flights to the GPU node pool.
# APP_GPU_TOLERATION: the taint key on that pool. GPU pools are normally tainted
#   to keep ordinary workloads off them, and without a toleration every flight
#   sits Pending forever. Only the key is configurable — the effect is NoSchedule.
# APP_IMAGE_PULL_SECRET: name of a Secret in APP_NAMESPACE, if the app image is
#   in a private registry.
APP_NAMESPACE=agrarian-flights
APP_GPU_COUNT=1
APP_NODE_SELECTOR=
APP_GPU_TOLERATION=nvidia.com/gpu
APP_IMAGE_PULL_SECRET=

# -----------------------------------------------------------------------------
# RECORDING  (MediaMTX records the annotated stream; recorder sidecar uploads it)
# RECORDING_STORE_SERVICE: local | azure | aws
#   local — file stays on the recordings Docker volume
#   azure — upload to Azure Blob Storage (requires RECORDING_AZURE_* vars)
#   aws   — upload to AWS S3 (requires RECORDING_AWS_* vars)
# RECORDING_DELETE_LOCAL_ON_SUCCESS: delete the local file after a successful
#   remote upload (ignored when service=local)
# -----------------------------------------------------------------------------
RECORDING_STORE_SERVICE=local
RECORDING_DELETE_LOCAL_ON_SUCCESS=false

# Azure Blob Storage
RECORDING_AZURE_CONNECTION_STRING=
RECORDING_AZURE_CONTAINER_NAME=
RECORDING_AZURE_BLOB_PREFIX=

# AWS S3
RECORDING_AWS_BUCKET_NAME=
RECORDING_AWS_KEY_PREFIX=
RECORDING_AWS_ACCESS_KEY_ID=
RECORDING_AWS_SECRET_ACCESS_KEY=
RECORDING_AWS_REGION_NAME=
