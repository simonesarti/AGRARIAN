# Addresses the BROWSER and the DRONE dial — not ones any pod dials.
#
#   cp endpoints.env.example endpoints.env    and fill in, then kubectl apply -k configs/
#
# The load balancer ADDRESSES are not knowable until the Services have been
# provisioned, which is why this is a deploy-time file rather than values in a
# manifest:
#
#   kubectl -n agrarian get svc traefik mediamtx-public mosquitto-public
#
# USE NAMES HERE, NOT THE ADDRESSES THAT COMMAND PRINTS. The domain exists as of
# 2026-08-09 and the certificate all three terminators serve covers names, not IPs.
# Point the A records at the load balancers once, and these values then stop
# changing when a Service is recreated and hands back a different address.
#
# ONE THING TO SETTLE BEFORE FILLING THIS IN. MEDIA_PUBLIC_HOST below is used for
# four ports that do NOT all live on the same load balancer: the portal composes
# HLS (8888) and WHEP (8889) URLs from it, and those are on the TRAEFIK Service,
# while RTMPS (1936) and the WebRTC ICE candidate (8189) are on MEDIAMTX-PUBLIC.
# Under docker-compose one host fronts everything and the split is invisible. Here
# it is real, and there are two ways out:
#
#   (a) give both Services the same address — on Azure, one pre-created Standard
#       public IP attached to both via the azure-pip-name annotation, which works
#       because their port sets do not overlap — and then one name covers both;
#   (b) split the variable in portal/main.py, so HLS and WHEP compose from a
#       Traefik name and the ingest URL and ICE host from a MediaMTX name.
#
# (a) needs no code change and is the assumption below. Whichever is chosen, it has
# to be chosen before the first flight, because the failure mode of getting it
# wrong is the one that looks like success: WHEP answers 201 and no video arrives.

# Where MediaMTX is reachable from a browser and from a drone. Used twice, and both
# uses have to agree: the portal composes WHEP and HLS URLs from it, and MediaMTX
# advertises it as its ICE host candidate (MTX_WEBRTCADDITIONALHOSTS). If this is
# wrong the WHEP POST still returns 201 and no video ever arrives — the failure the
# watch page's autoplay item was originally confused with.
MEDIA_PUBLIC_HOST=ingest.agrarianlivestock.com

# Where HLS (8888) and WHEP signalling (8889) are reachable — the TRAEFIK load
# balancer, not the MediaMTX one, because those two are the only MediaMTX ports
# Traefik terminates.
#
# This is option (b) above. LEAVE IT EMPTY if you took option (a) and gave both
# Services one address: it then falls back to MEDIA_PUBLIC_HOST and behaves exactly
# as the compose stack always has. Set it only when the two addresses differ.
#
# It equals WS_PUBLIC_HOST whenever it is set at all — same Traefik, same load
# balancer — and is a separate variable only because "where the WebSocket is" and
# "where the video manifests are" are two facts that a future topology could split
# again.
MEDIA_HTTP_PUBLIC_HOST=

# Where ws-server's viewer WebSocket is reachable — the Traefik load balancer, not
# the MediaMTX one.
WS_PUBLIC_HOST=agrarianlivestock.com
WS_PORT=8765

# HOW MANY PROXIES SIT BETWEEN THE BROWSER AND THE PORTAL. It decides which
# X-Forwarded-For entry the rate limiter believes, counting from the RIGHT.
#
# 1 is correct for this topology: an L4 load balancer with externalTrafficPolicy:
# Local preserves the source address and adds no HTTP hop, and Traefik adds one. A
# cloud L7 load balancer in front of Traefik would make it 2 — but §7 rules one out
# anyway, because it cannot carry RTMPS, MQTTS or WebRTC.
#
# Both directions are dangerous and they fail differently. Too HIGH and a client
# names its own bucket, and can push another client's bucket to the limit to lock
# them out. Too LOW and every client on the internet lands in one bucket, where one
# attacker locks out everybody.
TRUSTED_PROXY_HOPS=1

# Hosts the portal accepts as an Origin on state-changing requests. Empty means it
# derives one from the request, which is right behind a single known proxy and
# wrong the moment there are two names for this deployment.
PORTAL_ALLOWED_ORIGIN_HOSTS=
