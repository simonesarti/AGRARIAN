# Addresses the BROWSER and the DRONE dial — not ones any pod dials.
#
#   cp endpoints.env.example endpoints.env    and fill in, then kubectl apply -k configs/
#
# These are not knowable until the two LoadBalancer Services have been provisioned,
# which is why they are a deploy-time file rather than values in a manifest:
#
#   kubectl -n agrarian get svc traefik mediamtx-public mosquitto-public
#
# Once a hostname exists (§9's first ask) these all become that name and stop
# changing when a load balancer is recreated. Until then they are addresses, and an
# IP is exactly why cert-manager cannot issue yet.

# Where MediaMTX is reachable from a browser and from a drone. Used twice, and both
# uses have to agree: the portal composes WHEP and HLS URLs from it, and MediaMTX
# advertises it as its ICE host candidate (MTX_WEBRTCICEHOSTNAT1TO1IPS). If this is
# wrong the WHEP POST still returns 201 and no video ever arrives — the failure the
# watch page's autoplay item was originally confused with.
MEDIA_PUBLIC_HOST=203.0.113.10

# Where ws-server's viewer WebSocket is reachable — the Traefik load balancer, not
# the MediaMTX one.
WS_PUBLIC_HOST=203.0.113.11
WS_PORT=8765

# HOW MANY PROXIES SIT BETWEEN THE BROWSER AND THE PORTAL. It decides which
# X-Forwarded-For entry the rate limiter believes, counting from the RIGHT.
#
# 1 is correct for this topology: an L4 load balancer with externalTrafficPolicy:
# Local preserves the source address and adds no HTTP hop, and Traefik adds one. A
# cloud L7 load balancer in front of Traefik would make it 2 — but §7 rules one out
# anyway, because it cannot carry RTMPS, MQTTS or WebRTC.
#
# Both directions are dangerous and they fail differently. Too HIGH and a client
# names its own bucket, and can push another client's bucket to the limit to lock
# them out. Too LOW and every client on the internet lands in one bucket, where one
# attacker locks out everybody.
TRUSTED_PROXY_HOPS=1

# Hosts the portal accepts as an Origin on state-changing requests. Empty means it
# derives one from the request, which is right behind a single known proxy and
# wrong the moment there are two names for this deployment.
PORTAL_ALLOWED_ORIGIN_HOSTS=
