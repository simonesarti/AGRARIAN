# What the orchestrator injects into every flight container.
#
#   cp flight-app.env.example flight-app.env    and fill in
#
# Anything prefixed APP_ENV_ is forwarded to the flight with the prefix stripped.
# The orchestrator does not interpret any of it, and per-flight values — flight id,
# publisher token, stream paths — always win over these.

# The GPU image to run per flight. A moving tag here is worse than elsewhere: it
# decides what code processes a flight, and two flights in the same afternoon could
# silently run different builds.
APP_IMAGE=ghcr.io/REPLACE_ME/agrarian-app:v0.1.0

# Service names in this namespace, which is what changes from the compose file.
# There is no APP_NETWORK equivalent: pods share a cluster network and find each
# other by service DNS.
APP_ENV_DB_WRITER_URL=http://db-writer:8000
APP_ENV_WS_SERVER_URL=http://ws-server-alerts:8000
APP_ENV_VIDEO_STREAM_READER_HOST=mediamtx
APP_ENV_VIDEO_OUT_STREAM_HOST=mediamtx
APP_ENV_TELEMETRY_LISTENER_HOST=mosquitto

# danger_detection | health_monitoring. Only danger_detection consumes telemetry —
# health_monitoring instantiates no FrameTelemetryCombiner at all, so the Mosquitto
# hop above is unused in that mode.
#
# This is now the DEFAULT rather than the decision. A stream slot may name its own
# mode, and the orchestrator injects that instead — which is what lets one deployment
# serve a livestock tenant and a terrain tenant at once. A slot expressing no
# preference falls through to this value, so a single-product deployment behaves
# exactly as it did before slots could choose.
APP_ENV_APP_MODE=danger_detection

# WARNING (default) writes almost nothing: fifteen modules end their logger setup
# with a hardcoded setLevel(WARNING), and app/main.py installs no StreamHandler, so
# `kubectl logs` on a flight pod is near-empty by design. INFO is what makes the
# diagnostics the workers already write actually observable.
APP_ENV_LOG_LEVEL=WARNING
